{
  "name": "revue",
  "version": "0.1.1",
  "description": "Revue — a web UI for reviewing patches in git worktrees",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alastor0325/revue.git"
  },
  "homepage": "https://github.com/alastor0325/revue#readme",
  "bugs": {
    "url": "https://github.com/alastor0325/revue/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "revue": "./bin/revue.js"
  },
  "scripts": {
    "test": "jest --testPathPattern=test/(?!ui) --forceExit --silent",
    "test:ui": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=test/ui --forceExit --testTimeout=30000",
    "test:watch": "jest --testPathPattern=test/(?!ui) --watch --forceExit",
    "test:coverage": "jest --testPathPattern=test/(?!ui) --coverage --forceExit --silent",
    "dev": "nodemon --watch src --watch public --watch bin bin/revue.js --no-open"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  },
  "dependencies": {
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "babel-jest": "^30.3.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.59.1",
    "supertest": "^6.3.0"
  }
}
